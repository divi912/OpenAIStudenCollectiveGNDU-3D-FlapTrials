# Client: build-time value only. Leave unset for local development or combined production hosting.
# VITE_SERVER_URL=https://your-game-server.example.com
# The configured public website is recognized in both production build modes;
# edit .env.cloudflare to change its public origin/backend mapping.

# Server runtime settings.
PORT=2567
MAX_ROOMS=10
# Generous backend fallbacks per socket peer; the gateway has per-client edge limits.
HTTP_REQUESTS_PER_MINUTE=600
HEALTH_REQUESTS_PER_MINUTE=1200
# CLIENT_ORIGIN=https://your-client.pages.dev
