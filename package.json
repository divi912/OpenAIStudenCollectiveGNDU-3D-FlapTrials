{
  "name": "flap-trials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "dev": "concurrently -k -n CLIENT,SERVER -c cyan,yellow \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --platform node --out-dir dist/server --no-splitting",
    "start": "node dist/server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:build": "node scripts/build-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0",
    "@colyseus/core": "^0.18.23",
    "@colyseus/schema": "5.0.42",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/tools": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.0",
    "compression": "^1.8.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
