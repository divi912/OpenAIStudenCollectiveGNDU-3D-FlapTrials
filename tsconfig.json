{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "types": ["node"],
    "useDefineForClassFields": false
  },
  "include": ["client", "server", "shared", "worker", "scripts", "tests", "*.ts"]
}
