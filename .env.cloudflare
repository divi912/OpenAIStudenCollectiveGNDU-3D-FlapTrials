# Public browser endpoint, embedded in both frontend build modes.
# Cloudflare forwards API/WebSocket traffic to MULTIPLAYER_BACKEND in wrangler.jsonc.
# Ordinary production/LAN builds use this endpoint only on the public origin.
VITE_SERVER_URL=https://flaptrials.divii.xyz
VITE_CLIENT_ORIGIN=https://flaptrials.divii.xyz
